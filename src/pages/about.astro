---
import BaseLayout from '../layouts/BaseLayout.astro';
import Socials from '../components/Socials.astro';
import '../styles/global.css';
---

<BaseLayout pageTitle="About Me" showBackButton={true}>
    <p>
        Hey, my name is Noel. <span class="pronouns">(they/them)</span><br/>
        I'm a 24 year old Spanish-German software developer who loves puzzles and music.<br/>
        I have a dual apprenticeship in game development and design and multiple years of hands-on programming experience.<br/>
        Currently, I am a core-curriculum graduate at <a href="https://www.42heilbronn.de/en/learning-model/">42Heilbronn</a>
        and just finished a full-time internship at Audi Sport as an HMI embedded software developer.<br/>
        I also make electronic music individually and for games in my spare time. I will make a page for this in the future.<br/>
        <br/>
        Feel free to get in contact via these:<br/>
    </p>
	<Socials />
</BaseLayout>

<style>
    .pronouns {
        background: linear-gradient(45deg, #f5d142, #ffffff, #b084f5, #111111);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-left: 0.35rem;
        font-size: 0.9em;
    }
</style>
